---
import type { TimelineEvent } from "../data/timeline.ts";

interface Props {
  ev: TimelineEvent;
}

const { ev } = Astro.props;
const classes = ["event", "reveal", ev.side, ev.feature ? "feature" : ""]
  .filter(Boolean)
  .join(" ");
---

<div class={classes} id={`event-${ev.id}`}>
  <div class="event-node"></div>
  <div class="event-connector"></div>
  <div class="event-card">
    <span class="corner tl"></span>
    <span class="corner tr"></span>
    <span class="corner bl"></span>
    <span class="corner br"></span>

    <div class="event-kicker">
      <span class="glyph">{ev.glyph}</span>
      <span>{ev.kicker}</span>
    </div>
    <h3 class="event-title">{ev.title}</h3>
    <p class="event-body">{ev.body}</p>

    <div class="event-detail">
      <div class="event-detail-divider">Lore</div>
      <p class="event-detail-body">{ev.detail}</p>
      {ev.refs && ev.refs.length > 0 && (
        <div class="event-refs">
          Cited in
          <ul>
            {ev.refs.map((r) => <li>{r}</li>)}
          </ul>
        </div>
      )}
    </div>

    <div class="event-foot">
      <div class="event-tags">
        {ev.tags && ev.tags.map((t) => <span>{t}</span>)}
      </div>
      <span class="event-expand">
        <span class="lbl-closed">Unfurl</span>
        <span class="lbl-open">Seal</span>
        <span class="chev">▾</span>
      </span>
    </div>
  </div>
</div>
