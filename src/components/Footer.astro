---
import Ornament from "./Ornament.astro";
---

<footer class="foot">
  <Ornament />
  <div class="foot-mark">For the Worldsoul</div>
  <p class="foot-note">
    Sourced from Blizzard's published chronicles, supplemental novels, and the
    words spoken — perhaps unwisely — by characters who claimed to remember.
  </p>

  <section class="foot-call">
    <div class="foot-call-eyebrow">A Summons</div>
    <h3 class="foot-call-title">The Scribes Seek Aid</h3>
    <p class="foot-call-body">
      No single chronicler may hold every age in mind. If an error catches your
      eye, a forgotten thread returns to memory, or a chapter remains yet
      uninscribed — take up the quill alongside us.
    </p>
    <div class="foot-call-actions">
      <a
        class="foot-call-link"
        href="https://github.com/thraizz/chronicles-of-azeroth"
        target="_blank"
        rel="noopener"
      >
        <svg
          viewBox="0 0 24 24"
          width="14"
          height="14"
          fill="currentColor"
          aria-hidden="true"
        >
          <path
            d="M12 .5C5.65.5.5 5.65.5 12c0 5.08 3.29 9.39 7.86 10.91.58.11.79-.25.79-.56 0-.27-.01-1-.02-1.96-3.2.69-3.87-1.54-3.87-1.54-.52-1.32-1.27-1.67-1.27-1.67-1.04-.71.08-.7.08-.7 1.15.08 1.76 1.18 1.76 1.18 1.02 1.75 2.68 1.24 3.34.95.1-.74.4-1.24.73-1.52-2.55-.29-5.24-1.28-5.24-5.69 0-1.26.45-2.29 1.18-3.09-.12-.29-.51-1.46.11-3.05 0 0 .97-.31 3.18 1.18a11.1 11.1 0 0 1 5.8 0c2.21-1.49 3.18-1.18 3.18-1.18.63 1.59.23 2.76.11 3.05.74.8 1.18 1.83 1.18 3.09 0 4.42-2.69 5.4-5.26 5.68.41.36.78 1.06.78 2.13 0 1.54-.01 2.78-.01 3.16 0 .31.21.68.8.56 4.56-1.52 7.85-5.83 7.85-10.91C23.5 5.65 18.35.5 12 .5z"
          ></path>
        </svg>
        <span>View the Codex on GitHub</span>
      </a>
      <a
        class="foot-call-link"
        href="https://github.com/thraizz/chronicles-of-azeroth/blob/main/src/data/timeline.ts"
        target="_blank"
        rel="noopener"
      >
        <svg
          viewBox="0 0 24 24"
          width="14"
          height="14"
          fill="none"
          stroke="currentColor"
          stroke-width="1.6"
          stroke-linecap="round"
          stroke-linejoin="round"
          aria-hidden="true"
        >
          <path d="M3 21c1.5-3 4.5-6 9-9 2-1.3 4.5-2 6-2"></path>
          <path d="M18 10l3-3-3-3-3 3 3 3z"></path>
          <path d="M14.5 6.5l-9 9L4 21l5.5-1.5 9-9"></path>
        </svg>
        <span>Inscribe an Entry</span>
      </a>
    </div>
  </section>

  <p class="foot-disclaimer">
    This is an unofficial fan project and is not affiliated with, endorsed by,
    or sponsored by Blizzard Entertainment. World of Warcraft, Warcraft, and
    all related characters, names, and lore are trademarks of Blizzard
    Entertainment, Inc. All game content and materials are © Blizzard
    Entertainment.
  </p>
</footer>
